##################################
# Application
##################################

APP_NAME=NexaSocial
APP_ENV=production
APP_PORT=3001
APP_URL=https://api.nexasocial.com

##################################
# Database
##################################

DB_HOST=prod-db-endpoint
DB_PORT=3306
DB_USERNAME=prod-db-username
DB_PASSWORD=prod-db-password
DB_DATABASE=nexasocial_prod

##################################
# JWT
##################################

JWT_SECRET=production_jwt_secret_key_must_be_extremely_long_and_random_128_bits
JWT_EXPIRES_IN=1h

JWT_REFRESH_SECRET=production_jwt_refresh_secret_key_must_be_extremely_long_and_random_128_bits
JWT_REFRESH_EXPIRES_IN=7d

##################################
# Mail
##################################

MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USER=apikey
MAIL_PASSWORD=prod-sendgrid-apikey
MAIL_FROM=noreply@nexasocial.com

##################################
# Redis
##################################

REDIS_HOST=prod-redis-endpoint
REDIS_PORT=6379

##################################
# Cloudinary
##################################

CLOUDINARY_CLOUD_NAME=prod-cloud-name
CLOUDINARY_API_KEY=prod-cloudinary-key
CLOUDINARY_API_SECRET=prod-cloudinary-secret

##################################
# YouTube
##################################

YOUTUBE_CLIENT_ID=prod-yt-client-id
YOUTUBE_CLIENT_SECRET=prod-yt-client-secret

##################################
# Facebook
##################################

FACEBOOK_CLIENT_ID=prod-fb-client-id
FACEBOOK_CLIENT_SECRET=prod-fb-client-secret

##################################
# Google OAuth
##################################

GOOGLE_CLIENT_ID=prod-google-client-id
GOOGLE_CLIENT_SECRET=prod-google-client-secret

##################################
# Stripe
##################################

STRIPE_SECRET_KEY=sk_live_prod_key
STRIPE_WEBHOOK_SECRET=whsec_prod_secret
